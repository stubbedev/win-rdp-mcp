[
  {
    "name": "Snapshot",
    "description": "Capture desktop screenshot, window list, and interactive UI elements.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "use_vision": { "type": "boolean", "default": true, "description": "Include the screenshot image (default true)." },
        "quality": { "type": "integer", "default": 75, "minimum": 1, "maximum": 100, "description": "JPEG quality 1-100. Lower = smaller." },
        "max_width": { "type": "integer", "default": 0, "description": "Max image width in pixels. 0 = native resolution." },
        "monitor": { "type": "integer", "default": 0, "description": "Monitor to capture. 0 = all monitors, 1/2/3 = a specific monitor." }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "AnnotatedSnapshot",
    "description": "Screenshot with numbered red boxes drawn on each interactive UI element, so click targets can be named by number.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "max_elements": { "type": "integer", "default": 30, "description": "Maximum number of elements to annotate." },
        "quality": { "type": "integer", "default": 75, "minimum": 1, "maximum": 100, "description": "JPEG quality 1-100." },
        "max_width": { "type": "integer", "default": 0, "description": "Max image width in pixels. 0 = native resolution." }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "Click",
    "description": "Mouse click at screen coordinates.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "x": { "type": "integer", "description": "X coordinate." },
        "y": { "type": "integer", "description": "Y coordinate." },
        "button": { "type": "string", "enum": ["left", "right", "middle"], "default": "left" },
        "action": { "type": "string", "enum": ["click", "double", "hover"], "default": "click" }
      },
      "required": ["x", "y"],
      "additionalProperties": false
    }
  },
  {
    "name": "Type",
    "description": "Type text, optionally clicking a position first.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "text": { "type": "string", "description": "Text to type." },
        "x": { "type": "integer", "default": 0, "description": "X coordinate (0 = current position)." },
        "y": { "type": "integer", "default": 0, "description": "Y coordinate (0 = current position)." },
        "clear": { "type": "boolean", "default": false, "description": "Clear existing content first (Ctrl+A, Delete)." },
        "press_enter": { "type": "boolean", "default": false, "description": "Press Enter after typing." }
      },
      "required": ["text"],
      "additionalProperties": false
    }
  },
  {
    "name": "Scroll",
    "description": "Scroll at a position.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "amount": { "type": "integer", "description": "Scroll amount in notches (positive = up/right, negative = down/left)." },
        "x": { "type": "integer", "default": 0, "description": "X coordinate (0 = current)." },
        "y": { "type": "integer", "default": 0, "description": "Y coordinate (0 = current)." },
        "horizontal": { "type": "boolean", "default": false, "description": "Horizontal scroll instead of vertical." }
      },
      "required": ["amount"],
      "additionalProperties": false
    }
  },
  {
    "name": "Move",
    "description": "Move the mouse, or drag from one position to another.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "x": { "type": "integer", "description": "Target X." },
        "y": { "type": "integer", "description": "Target Y." },
        "drag": { "type": "boolean", "default": false, "description": "Hold the left button while moving." },
        "start_x": { "type": "integer", "default": 0, "description": "Drag start X." },
        "start_y": { "type": "integer", "default": 0, "description": "Drag start Y." },
        "duration": { "type": "number", "default": 0.3, "description": "Movement duration in seconds." }
      },
      "required": ["x", "y"],
      "additionalProperties": false
    }
  },
  {
    "name": "Shortcut",
    "description": "Execute a keyboard shortcut, e.g. 'ctrl+c', 'alt+tab', 'win+e'.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "keys": { "type": "string", "description": "Plus-separated key names, e.g. 'ctrl+shift+esc'." }
      },
      "required": ["keys"],
      "additionalProperties": false
    }
  },
  {
    "name": "Wait",
    "description": "Pause for a number of seconds. Useful between UI actions.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "seconds": { "type": "number", "default": 1.0, "description": "Seconds to wait (max 60)." }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "FocusWindow",
    "description": "Bring a window to the foreground by title (fuzzy) or handle (exact).",
    "inputSchema": {
      "type": "object",
      "properties": {
        "title": { "type": "string", "default": "", "description": "Window title, fuzzy matched." },
        "handle": { "type": "integer", "default": 0, "description": "Window handle, exact." }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "MinimizeAll",
    "description": "Minimize all windows (Win+D — show desktop).",
    "inputSchema": { "type": "object", "properties": {}, "additionalProperties": false }
  },
  {
    "name": "App",
    "description": "Launch, switch to, or resize an application window.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "action": { "type": "string", "enum": ["launch", "switch", "resize"], "default": "launch" },
        "name": { "type": "string", "default": "", "description": "Application name or path (launch/switch)." },
        "args": { "type": "string", "default": "", "description": "Arguments (launch)." },
        "handle": { "type": "integer", "default": 0, "description": "Window handle (switch/resize)." },
        "width": { "type": "integer", "default": 0, "description": "New width (resize)." },
        "height": { "type": "integer", "default": 0, "description": "New height (resize)." }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "Shell",
    "description": "Execute a PowerShell command on the Windows host.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "command": { "type": "string", "description": "PowerShell command to execute." },
        "timeout": { "type": "integer", "default": 30, "description": "Timeout in seconds." },
        "cwd": { "type": "string", "default": "", "description": "Working directory to run in." }
      },
      "required": ["command"],
      "additionalProperties": false
    }
  },
  {
    "name": "GetClipboard",
    "description": "Read the Windows clipboard text content.",
    "inputSchema": { "type": "object", "properties": {}, "additionalProperties": false }
  },
  {
    "name": "SetClipboard",
    "description": "Set the Windows clipboard text content.",
    "inputSchema": {
      "type": "object",
      "properties": { "text": { "type": "string", "description": "Text to place on the clipboard." } },
      "required": ["text"],
      "additionalProperties": false
    }
  },
  {
