      "type": "object",
      "properties": {
        "pid": { "type": "integer", "default": 0, "description": "Process ID." },
        "name": { "type": "string", "default": "", "description": "Process name, fuzzy matched." }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "GetSystemInfo",
    "description": "System information: CPU, memory, disk, network counters, uptime.",
    "inputSchema": { "type": "object", "properties": {}, "additionalProperties": false }
  },
  {
    "name": "ReconnectSession",
