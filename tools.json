      "type": "object",
      "properties": {
        "log_name": { "type": "string", "default": "System", "description": "Log name: System, Application, Security, ..." },
        "count": { "type": "integer", "default": 20, "description": "Number of entries (1-1000)." },
        "level": { "type": "string", "enum": ["", "critical", "error", "warning", "information", "verbose"], "default": "" }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "OCR",
