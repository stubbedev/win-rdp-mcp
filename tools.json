      "type": "object",
      "properties": {
        "path": { "type": "string", "default": "", "description": "Local file path, e.g. C:\\Music\\alert.wav." },
        "url": { "type": "string", "default": "", "description": "URL to an audio file; downloaded to a temp file first (10 MB limit)." }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "LockScreen",
    "description": "Lock the Windows workstation.",
    "inputSchema": { "type": "object", "properties": {}, "additionalProperties": false }
  },
  {
    "name": "Scrape",
    "description": "Fetch a URL and return its content as markdown.",
    "inputSchema": {
      "type": "object",
      "properties": { "url": { "type": "string", "description": "URL to fetch." } },
      "required": ["url"],
      "additionalProperties": false
    }
  },
  {
    "name": "FileRead",
    "description": "Read file content. Pass encoding 'binary' for base64 output.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "path": { "type": "string", "description": "File path." },
        "encoding": { "type": "string", "default": "utf-8", "description": "Text encoding, or 'binary' for base64." }
      },
      "required": ["path"],
      "additionalProperties": false
    }
  },
  {
    "name": "FileWrite",
    "description": "Write text content to a file, creating parent directories as needed.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "path": { "type": "string", "description": "File path." },
        "content": { "type": "string", "description": "Content to write." },
        "encoding": { "type": "string", "default": "utf-8", "description": "Text encoding." },
        "append": { "type": "boolean", "default": false, "description": "Append instead of overwrite." }
      },
      "required": ["path", "content"],
      "additionalProperties": false
    }
  },
  {
    "name": "FileList",
    "description": "List directory contents with size and modification date.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "path": { "type": "string", "default": ".", "description": "Directory path." },
        "show_hidden": { "type": "boolean", "default": false, "description": "Include dot-prefixed entries." }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "FileSearch",
    "description": "Search files by glob name pattern.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "pattern": { "type": "string", "description": "Glob pattern, e.g. '*.log', 'report*'." },
        "path": { "type": "string", "default": ".", "description": "Root directory to search." },
        "recursive": { "type": "boolean", "default": true, "description": "Search subdirectories." },
        "limit": { "type": "integer", "default": 50, "description": "Max results." }
      },
      "required": ["pattern"],
      "additionalProperties": false
    }
  },
  {
    "name": "FileDownload",
    "description": "Read a file as base64-encoded content. Use for binary files.",
    "inputSchema": {
      "type": "object",
      "properties": { "path": { "type": "string", "description": "File path to download." } },
      "required": ["path"],
      "additionalProperties": false
    }
  },
  {
    "name": "FileUpload",
    "description": "Write a file from base64-encoded content. Use for binary files.",
